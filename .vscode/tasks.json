{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run LÖVE",
      "type": "shell",
      "command": "love",
      "args": ["${workspaceFolder}/src"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Build .love",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/build.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build .love (verify)",
      "detail": "Packages src/ and launches the archive from an empty directory, so a module that only resolves via the working directory fails here instead of after release.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/build.ps1",
        "-Verify"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
